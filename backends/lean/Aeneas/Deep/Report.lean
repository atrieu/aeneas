module
public import Lean
public import Aeneas.Deep.Compile
public section

/-! # Coverage report of the compiler

`#deep_report` runs the compiler (`Aeneas.Deep.Compile.compile`) on every deep term of the
environment (the constants named `….deep` generated by `-deep`), by reducing
`compile f.deep` with the elaborator under the binders of `f.deep`, and reports which
terms are in the first-order fragment and why the others are not. -/

namespace Aeneas.Deep

open Lean Meta Elab Command

/-- The outcome of compiling one deep term -/
meta inductive ReportEntry where
  | ok (name : Name)
  | unsupported (name : Name) (reason : String)
  | failed (name : Name) (msg : String)

/-- The reason of an `Unsupported` value, as a string (the value is a closed term after
reduction) -/
meta def unsupportedReason (e : Lean.Expr) : MetaM String := do
  let e ← whnfD e
  match e.getAppFn.constName? with
  | some ``Compile.Unsupported.leaf =>
    let tag ← whnfD e.appArg!
    match tag.getAppFn.constName?, tag.getAppArgs with
    | some n, #[.lit (.strVal s)] => return s!"leaf {n.getString!} {s}"
    | some n, _ => return s!"leaf {n.getString!}"
    | none, _ => return "leaf"
  | some n => return n.getString!
  | none => return "?"

/-- Is this constant a deep term (its type is `Aeneas.Deep.Expr …` under binders)? -/
meta def isDeepTerm (n : Name) : TermElabM Bool := do
  if n.isInternal || n.getString! != "deep" then return false
  let some ci := (← getEnv).find? n | return false
  forallTelescope ci.type fun _ ty => do
    return (← whnfD ty).getAppFn.constName? == some ``Aeneas.Deep.Expr

/-- Compile a deep term and classify the result -/
meta def reportConst (n : Name) : TermElabM ReportEntry := do
  let ci ← getConstInfo n
  try
    forallTelescope ci.type fun xs _ => do
      let e := mkAppN (mkConst n (ci.levelParams.map mkLevelParam)) xs
      let app ← mkAppM ``Compile.compile #[e]
      let r ← whnfD app
      match r.getAppFn.constName? with
      | some ``Except.ok => return .ok n
      | some ``Except.error => return .unsupported n (← unsupportedReason r.appArg!)
      | _ => return .failed n s!"reduction stuck: {← ppExpr r}"
  catch ex => return .failed n (← ex.toMessageData.toString)

/-- Run the compiler on every deep term of the environment and report. With `verbose`,
list every term; otherwise list the unsupported ones only. -/
elab "#deep_report" verbose:(&" verbose")? : command => do
  let env ← getEnv
  let names := env.constants.fold (init := #[]) fun acc n _ =>
    if !n.isInternal && n.getString! == "deep" then acc.push n else acc
  let names := names.qsort (fun a b => a.toString < b.toString)
  let names ← liftTermElabM <| names.filterM isDeepTerm
  let entries ← liftTermElabM <| names.mapM reportConst
  let mut ok : Nat := 0
  let mut reasons : Std.HashMap String Nat := {}
  let mut lines : Array String := #[]
  for e in entries do
    match e with
    | .ok n =>
      ok := ok + 1
      if verbose.isSome then lines := lines.push s!"ok: {n}"
    | .unsupported n r =>
      reasons := reasons.insert r (reasons.getD r 0 + 1)
      lines := lines.push s!"unsupported ({r}): {n}"
    | .failed n m => lines := lines.push s!"FAILED: {n}: {m}"
  let summary := reasons.toArray.qsort (fun a b => a.2 > b.2)
    |>.map (fun (r, k) => s!"  {k} × {r}")
  logInfo m!"deep_report: {ok} / {entries.size} deep terms compile\n{"\n".intercalate summary.toList}\n{"\n".intercalate lines.toList}"

end Aeneas.Deep

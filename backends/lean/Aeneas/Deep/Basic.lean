module
public import Aeneas.Std.Primitives
@[expose] public section

/-! # Deep embedding of the pure AST

This file defines an intrinsically typed deep embedding of the bodies of the definitions
generated by Aeneas, together with its denotation.

The embedding is "deep structure, shallow leaves": binders, applications, conditionals,
matches, loops and monadic binds are first-order constructors, while literals, called
functions, globals and projectors are shallow Lean values wrapped in a tagged leaf. Types
are ordinary Lean types: a term of type `Expr Γ τ` denotes a value of type `τ` in an
environment of type `HList Γ`.

Design invariant: for every construct, `Expr.denote` must reduce to *exactly* the term that
the custom `do` elaborator (`Aeneas.Do.Elab`) and the standard elaborator produce for the
shallow definition, so that the theorem `f x = f.deep.denote (x ::ₕ .nil)` is provable
by `rfl` (or by `unfold f; rfl` for recursive definitions).
-/

namespace Aeneas.Deep

open Aeneas.Std

/-! ## Environments -/

/-- Heterogeneous lists, used as typing contexts and environments. -/
inductive HList : List Type → Type 1 where
  | nil : HList []
  | cons {τ : Type} {Γ : List Type} (x : τ) (xs : HList Γ) : HList (τ :: Γ)

infixr:67 " ::ₕ " => HList.cons

def HList.append : {Δ₁ Δ₂ : List Type} → HList Δ₁ → HList Δ₂ → HList (Δ₁ ++ Δ₂)
  | _, _, .nil, ys => ys
  | _, _, .cons x xs, ys => .cons x (xs.append ys)

/-- `Fn [α₁, …, αₙ] τ = α₁ → … → αₙ → τ` -/
@[reducible] def Fn : List Type → Type → Type
  | [], τ => τ
  | α :: Δ, τ => α → Fn Δ τ

def HList.curry : (Δ : List Type) → {τ : Type} → (HList Δ → τ) → Fn Δ τ
  | [], _, f => f .nil
  | _ :: Δ, _, f => fun a => HList.curry Δ (fun xs => f (a ::ₕ xs))

/-! ## Variables and patterns -/

/-- Typed de Bruijn indices. -/
inductive Var : List Type → Type → Type 1 where
  | zero {Γ : List Type} {τ : Type} : Var (τ :: Γ) τ
  | succ {Γ : List Type} {σ τ : Type} (v : Var Γ τ) : Var (σ :: Γ) τ

def Var.get : {Γ : List Type} → {τ : Type} → Var Γ τ → HList Γ → τ
  | _, _, .zero, .cons x _ => x
  | _, _, .succ v, .cons _ xs => v.get xs

/-- Irrefutable patterns. `Δ` lists the types of the bound variables, in binding order
(the order in which the shallow printer and the pure AST number them). -/
inductive Pat : Type → List Type → Type 1 where
  | var {τ : Type} : Pat τ [τ]
  | ignore {τ : Type} : Pat τ []
  | pair {α β : Type} {Δ₁ Δ₂ : List Type} (p : Pat α Δ₁) (q : Pat β Δ₂) : Pat (α × β) (Δ₁ ++ Δ₂)

/-- The environment extension produced by matching a value against a pattern. -/
def Pat.bindEnv : {α : Type} → {Δ : List Type} → Pat α Δ → α → HList Δ
  | _, _, .var, x => x ::ₕ .nil
  | _, _, .ignore, _ => .nil
  | _, _, .pair p q, x => (p.bindEnv x.1).append (q.bindEnv x.2)

/-! ## Matches -/

/-- `Alts [Δ₁, …, Δₙ] τ = Fn Δ₁ τ × (… × (Fn Δₙ τ × Unit))`: one curried continuation per
variant of the scrutinee type. -/
@[reducible] def Alts : List (List Type) → Type → Type
  | [], _ => Unit
  | Δ :: shape, τ => Fn Δ τ × Alts shape τ

/-- An eliminator for a type `σ` whose variants have fields `shape`. For an inductive type
`T` this is `T.casesOn` with a constant motive; Aeneas generates one per ADT in deep mode. -/
@[reducible] def Elim (σ : Type) (shape : List (List Type)) : Type 1 :=
  ∀ {τ : Type}, σ → Alts shape τ → τ

/-- A decidable proposition, used to denote `if` conditions. -/
structure DecProp : Type where
  prop : Prop
  dec : Decidable prop

/-! ## Expressions -/

/-- Tags describing what a shallow leaf stands for. Metadata only: the denotation ignores it.

The names come from the Rust side of the translation:
- `fn`: the Rust name of the function (`crate::f`), with a `^loopN` (resp. `^loopN^body`)
  suffix for the function generated for the `N`-th loop (resp. its body), or `@name` for the
  builtins of the translation (`@assert`, `@toResult`, `@arrayIndex`, …);
- `ctor`: the Rust name of the variant, or `@Result::Ok`, `@Continue`, … for the builtin ones;
- `proj`: the name of the field;
- `binop`: the operator with its overflow mode and its type (`panic.+::<u32>`, `<::<u32>`);
- `unop`: the operator (casts, negation, …);
- `global`: the Rust name of the global. -/
inductive Leaf where
  | lit
  | fn (name : String)
  | global (name : String)
  | ctor (name : String)
  | proj (name : String)
  | binop (name : String)
  | unop (name : String)
  | ret
  | fail
  | other (name : String)
  deriving Repr, DecidableEq, Inhabited

mutual
  inductive Expr : List Type → Type → Type 1 where
    | var {Γ : List Type} {τ : Type} (v : Var Γ τ) : Expr Γ τ
    /-- A shallow leaf: literal, function, global, constructor, projector, … -/
    | leaf {Γ : List Type} {τ : Type} (tag : Leaf) (c : τ) : Expr Γ τ
    | app {Γ : List Type} {α β : Type} (f : Expr Γ (α → β)) (a : Expr Γ α) : Expr Γ β
    | lam {Γ : List Type} {α β : Type} {Δ : List Type}
        (p : Pat α Δ) (body : Expr (Δ ++ Γ) β) : Expr Γ (α → β)
    /-- Non-monadic let-binding -/
    | let_ {Γ : List Type} {α β : Type} {Δ : List Type}
        (e : Expr Γ α) (p : Pat α Δ) (k : Expr (Δ ++ Γ) β) : Expr Γ β
    /-- Monadic let-binding -/
    | bind {Γ : List Type} {α β : Type} {Δ : List Type}
        (e : Expr Γ (Result α)) (p : Pat α Δ) (k : Expr (Δ ++ Γ) (Result β)) : Expr Γ (Result β)
    | ite {Γ : List Type} {τ : Type} (c : Cond Γ) (t e : Expr Γ τ) : Expr Γ τ
    /-- A condition used as a boolean: the shallow code coerces it with `decide` -/
    | decide {Γ : List Type} (c : Cond Γ) : Expr Γ Bool
    /-- `massert c` -/
    | assert {Γ : List Type} (c : Cond Γ) : Expr Γ (Result Unit)
    | match_ {Γ : List Type} {σ τ : Type} {shape : List (List Type)}
        (scrut : Expr Γ σ) (elim : Elim σ shape) (brs : Branches Γ shape τ) : Expr Γ τ
    /-- The loop fixed-point combinator -/
    | loop {Γ : List Type} {α β : Type}
        (body : Expr Γ (α → Result (ControlFlow α β))) (init : Expr Γ α) : Expr Γ (Result β)
    /-- Escape hatch: an arbitrary shallow function of the environment -/
    | shallow {Γ : List Type} {τ : Type} (f : HList Γ → τ) : Expr Γ τ

  /-- `if` conditions. Each constructor mirrors the proposition and the `Decidable` instance
  that the elaborator produces for the corresponding shallow syntax. -/
  inductive Cond : List Type → Type 1 where
    /-- `if b` where `b : Bool`, elaborated to `ite (b = true)` -/
    | bool {Γ : List Type} (b : Expr Γ Bool) : Cond Γ
    | eq {Γ : List Type} {α : Type} [inst : DecidableEq α] (a b : Expr Γ α) : Cond Γ
    | lt {Γ : List Type} {α : Type} [ord : LT α] [inst : DecidableRel (· < · : α → α → Prop)]
        (a b : Expr Γ α) : Cond Γ
    | le {Γ : List Type} {α : Type} [ord : LE α] [inst : DecidableRel (· ≤ · : α → α → Prop)]
        (a b : Expr Γ α) : Cond Γ
    | gt {Γ : List Type} {α : Type} [ord : LT α] [inst : DecidableRel (· < · : α → α → Prop)]
        (a b : Expr Γ α) : Cond Γ
    | ge {Γ : List Type} {α : Type} [ord : LE α] [inst : DecidableRel (· ≤ · : α → α → Prop)]
        (a b : Expr Γ α) : Cond Γ

  /-- Match branches, one per variant, each binding the variant's fields. -/
  inductive Branches : List Type → List (List Type) → Type → Type 1 where
    | nil {Γ : List Type} {τ : Type} : Branches Γ [] τ
    | cons {Γ : List Type} {Δ : List Type} {shape : List (List Type)} {τ : Type}
        (b : Expr (Δ ++ Γ) τ) (bs : Branches Γ shape τ) : Branches Γ (Δ :: shape) τ
end

/-! ## Denotation -/

mutual
  def Expr.denote : {Γ : List Type} → {τ : Type} → Expr Γ τ → HList Γ → τ
    | _, _, .var v, env => v.get env
    | _, _, .leaf _ c, _ => c
    | _, _, .app f a, env => (f.denote env) (a.denote env)
    | _, _, .lam p b, env => fun x => b.denote ((p.bindEnv x).append env)
    | _, _, .let_ e p k, env =>
      let x := e.denote env
      k.denote ((p.bindEnv x).append env)
    | _, _, .bind e p k, env =>
      Std.bind (e.denote env) (fun x => k.denote ((p.bindEnv x).append env))
    | _, _, .ite c t e, env =>
      @ite _ (c.denote env).prop (c.denote env).dec (t.denote env) (e.denote env)
    | _, _, .decide c, env => @Decidable.decide (c.denote env).prop (c.denote env).dec
    | _, _, .assert c, env => @Std.massert (c.denote env).prop (c.denote env).dec
    | _, _, .match_ s elim brs, env => elim (s.denote env) (brs.denote env)
    | _, _, .loop b i, env => Std.loop (b.denote env) (i.denote env)
    | _, _, .shallow f, env => f env

  def Cond.denote : {Γ : List Type} → Cond Γ → HList Γ → DecProp
    | _, .bool b, env => ⟨b.denote env = true, inferInstance⟩
    | _, .eq (inst := inst) a b, env => ⟨a.denote env = b.denote env, inst _ _⟩
    | _, .lt (ord := ord) (inst := inst) a b, env =>
      ⟨@LT.lt _ ord (a.denote env) (b.denote env), inst _ _⟩
    | _, .le (ord := ord) (inst := inst) a b, env =>
      ⟨@LE.le _ ord (a.denote env) (b.denote env), inst _ _⟩
    | _, .gt (ord := ord) (inst := inst) a b, env =>
      ⟨@GT.gt _ ord (a.denote env) (b.denote env), inst _ _⟩
    | _, .ge (ord := ord) (inst := inst) a b, env =>
      ⟨@GE.ge _ ord (a.denote env) (b.denote env), inst _ _⟩

  def Branches.denote : {Γ : List Type} → {shape : List (List Type)} → {τ : Type} →
      Branches Γ shape τ → HList Γ → Alts shape τ
    | _, _, _, .nil, _ => ()
    | _, _, _, .cons (Δ := Δ) b bs, env =>
      (HList.curry Δ (fun fields => b.denote (fields.append env)), bs.denote env)
end

/-! ## Helpers for building terms -/

namespace Expr

abbrev lit {Γ : List Type} {τ : Type} (c : τ) : Expr Γ τ := .leaf .lit c
abbrev call {Γ : List Type} {τ : Type} (name : String) (f : τ) : Expr Γ τ := .leaf (.fn name) f
abbrev global {Γ : List Type} {τ : Type} (name : String) (g : τ) : Expr Γ τ := .leaf (.global name) g
abbrev ctor {Γ : List Type} {τ : Type} (name : String) (c : τ) : Expr Γ τ := .leaf (.ctor name) c

abbrev app2 {Γ : List Type} {α β γ : Type}
    (f : Expr Γ (α → β → γ)) (a : Expr Γ α) (b : Expr Γ β) : Expr Γ γ :=
  .app (.app f a) b

abbrev app3 {Γ : List Type} {α β γ δ : Type}
    (f : Expr Γ (α → β → γ → δ)) (a : Expr Γ α) (b : Expr Γ β) (c : Expr Γ γ) : Expr Γ δ :=
  .app (.app (.app f a) b) c

abbrev binop {Γ : List Type} {α β γ : Type}
    (name : String) (op : α → β → γ) (a : Expr Γ α) (b : Expr Γ β) : Expr Γ γ :=
  app2 (.leaf (.binop name) op) a b

abbrev unop {Γ : List Type} {α β : Type} (name : String) (op : α → β) (a : Expr Γ α) : Expr Γ β :=
  .app (.leaf (.unop name) op) a

abbrev ok {Γ : List Type} {α : Type} (e : Expr Γ α) : Expr Γ (Result α) :=
  .app (.leaf .ret Result.ok) e

abbrev fail {Γ : List Type} {α : Type} (err : Error) : Expr Γ (Result α) :=
  .leaf .fail (Result.fail err)

abbrev pair {Γ : List Type} {α β : Type} (a : Expr Γ α) (b : Expr Γ β) : Expr Γ (α × β) :=
  app2 (.leaf (.ctor "Prod.mk") Prod.mk) a b

end Expr

/-! ## Eliminators for builtin types -/

@[reducible] def Bool.deepElim : Elim Bool [[], []] :=
  fun b alts => Bool.casesOn b alts.1 alts.2.1

@[reducible] def Option.deepElim {α : Type} : Elim (Option α) [[], [α]] :=
  fun x alts => Option.casesOn x alts.1 alts.2.1

@[reducible] def Prod.deepElim {α β : Type} : Elim (α × β) [[α, β]] :=
  fun x alts => Prod.casesOn x alts.1

@[reducible] def ControlFlow.deepElim {α β : Type} : Elim (ControlFlow α β) [[α], [β]] :=
  fun x alts => ControlFlow.casesOn x alts.1 alts.2.1

/-- `core::cmp::Ordering` is translated to Lean's `Ordering` (`lt`, `eq`, `gt`, in this order) -/
@[reducible] def Ordering.deepElim : Elim Ordering [[], [], []] :=
  fun x alts => Ordering.casesOn x alts.1 alts.2.1 alts.2.2.1

end Aeneas.Deep

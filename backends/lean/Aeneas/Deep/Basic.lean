module
public import Aeneas.Std
@[expose] public section

/-! # Deep embedding of the pure AST

This file defines an intrinsically typed deep embedding of the bodies of the definitions
generated by Aeneas, together with its denotation.

The embedding is "deep structure, shallow leaves": binders, applications, conditionals,
matches, loops, monadic binds, primitive operations and the constructors, projections and
matches of the ADTs of the crate are first-order constructors; the remaining leaves
(called functions, globals, …) are shallow Lean values wrapped in a tagged leaf.

Types are *descriptors* (`Ty N`), over a crate-level enumeration `N` of the type names of
the crate (generated by Aeneas, with a `TypeNames N` instance giving the Lean type and the
variants of every name). A term of type `Expr N F G σ Γ τ` denotes, in an environment
`Env N σ Γ`, a value of type `τ.denote σ`, where `σ : TyEnv` interprets the type
variables of the enclosing definition (`Ty.var i` is the `i`-th binder; the generated
`σ` also lists the types the descriptor language can not express, which are thus abstract
for a consumer of the deep term).

Design invariant: for every construct, `Expr.denote` must reduce to *exactly* the term that
the custom `do` elaborator (`Aeneas.Do.Elab`) and the standard elaborator produce for the
shallow definition, so that the theorem `f x = f.deep.denote (x ::ₑ .nil)` is provable
by `rfl` (or by `unfold f; rfl` for recursive definitions). In particular, no cast appears
in the denotation of a printed term: the nodes which relate two type computations carry a
proof of their equality, which is `rfl` in the generated terms (and reduces by iota).
-/

namespace Aeneas.Deep

open Aeneas.Std

/-! ## Heterogeneous lists and curried functions -/

/-- Heterogeneous lists over Lean types. -/
inductive HList : List Type → Type 1 where
  | nil : HList []
  | cons {τ : Type} {Γ : List Type} (x : τ) (xs : HList Γ) : HList (τ :: Γ)

infixr:67 " ::ₕ " => HList.cons

/-- `Fn [α₁, …, αₙ] τ = α₁ → … → αₙ → τ` -/
@[reducible] def Fn : List Type → Type → Type
  | [], τ => τ
  | α :: Δ, τ => α → Fn Δ τ

def HList.curry : (Δ : List Type) → {τ : Type} → (HList Δ → τ) → Fn Δ τ
  | [], _, f => f .nil
  | _ :: Δ, _, f => fun a => HList.curry Δ (fun xs => f (a ::ₕ xs))

def Fn.apply : {Δ : List Type} → {τ : Type} → Fn Δ τ → HList Δ → τ
  | [], _, f, .nil => f
  | _ :: _, _, f, .cons x xs => Fn.apply (f x) xs

/-- `Alts [Δ₁, …, Δₙ] τ = Fn Δ₁ τ × (… × (Fn Δₙ τ × Unit))`: one curried continuation per
variant of the scrutinee type. -/
@[reducible] def Alts : List (List Type) → Type → Type
  | [], _ => Unit
  | Δ :: shape, τ => Fn Δ τ × Alts shape τ

/-- An eliminator for a type `σ` whose variants have fields `shape`. For an inductive type
`T` this is `T.casesOn` with a constant motive. -/
@[reducible] def Elim (σ : Type) (shape : List (List Type)) : Type 1 :=
  ∀ {τ : Type}, σ → Alts shape τ → τ

/-- A decidable proposition, used to denote `if` conditions. -/
structure DecProp : Type where
  prop : Prop
  dec : Decidable prop

/-! ## Scalar and boolean primitives

First-order descriptions of the primitive operations, with a *fixed* denotation: for every
case, the denotation is written with the very notation the shallow printer prints, so that
the two elaborate to the same term. -/

/-- Scalar types, as data -/
inductive ScalarTy where
  | u (ty : UScalarTy)
  | i (ty : IScalarTy)

@[reducible] def ScalarTy.denote : ScalarTy → Type
  | .u ty => UScalar ty
  | .i ty => IScalar ty

/-- The checked binary operations on scalars, which the shallow printer prints with
notations: `+ - * / %` and `<<< >>>` (the right operand of a shift may have another
scalar type). They all return in `Result`. -/
inductive ScalarBinop where
  | add | sub | mul | div | rem
  | shl (rhs : ScalarTy) | shr (rhs : ScalarTy)

/-- The type of the right operand -/
@[reducible] def ScalarBinop.rhsTy : ScalarBinop → ScalarTy → ScalarTy
  | .shl rhs, _ | .shr rhs, _ => rhs
  | _, ty => ty

@[reducible] def ScalarBinop.denote :
    (op : ScalarBinop) → (ty : ScalarTy) → ty.denote → (op.rhsTy ty).denote → Result ty.denote
  | .add, .u _ => fun x y => x + y
  | .add, .i _ => fun x y => x + y
  | .sub, .u _ => fun x y => x - y
  | .sub, .i _ => fun x y => x - y
  | .mul, .u _ => fun x y => x * y
  | .mul, .i _ => fun x y => x * y
  | .div, .u _ => fun x y => x / y
  | .div, .i _ => fun x y => x / y
  | .rem, .u _ => fun x y => x % y
  | .rem, .i _ => fun x y => x % y
  | .shl (.u _), .u _ => fun x y => x <<< y
  | .shl (.i _), .u _ => fun x y => x <<< y
  | .shl (.u _), .i _ => fun x y => x <<< y
  | .shl (.i _), .i _ => fun x y => x <<< y
  | .shr (.u _), .u _ => fun x y => x >>> y
  | .shr (.i _), .u _ => fun x y => x >>> y
  | .shr (.u _), .i _ => fun x y => x >>> y
  | .shr (.i _), .i _ => fun x y => x >>> y

/-- The bitwise binary operations on scalars: `&&& ||| ^^^` (pure) -/
inductive ScalarBitop where
  | and | or | xor
  deriving DecidableEq, Repr

@[reducible] def ScalarBitop.denote :
    (op : ScalarBitop) → (ty : ScalarTy) → ty.denote → ty.denote → ty.denote
  | .and, .u _ => fun x y => x &&& y
  | .and, .i _ => fun x y => x &&& y
  | .or, .u _ => fun x y => x ||| y
  | .or, .i _ => fun x y => x ||| y
  | .xor, .u _ => fun x y => x ^^^ y
  | .xor, .i _ => fun x y => x ^^^ y

/-- `~~~ x` -/
@[reducible] def ScalarTy.bitNot : (ty : ScalarTy) → ty.denote → ty.denote
  | .u _, x => ~~~ x
  | .i _, x => ~~~ x

/-- The casts between scalar types (`UScalar.cast`, `UScalar.hcast`, `IScalar.cast`,
`IScalar.hcast`, as printed by the shallow printer) -/
@[reducible] def ScalarTy.cast : (src tgt : ScalarTy) → src.denote → tgt.denote
  | .u _, .u tgt, x => UScalar.cast tgt x
  | .u _, .i tgt, x => UScalar.hcast tgt x
  | .i _, .i tgt, x => IScalar.cast tgt x
  | .i _, .u tgt, x => IScalar.hcast tgt x

@[reducible] def ScalarTy.castFromBool : (tgt : ScalarTy) → Bool → tgt.denote
  | .u tgt, b => UScalar.cast_fromBool tgt b
  | .i tgt, b => IScalar.cast_fromBool tgt b

/-- `&&`, `||`, `^^` -/
inductive BoolBinop where
  | and | or | xor
  deriving DecidableEq, Repr

@[reducible] def BoolBinop.denote : BoolBinop → Bool → Bool → Bool
  | .and => fun x y => x && y
  | .or => fun x y => x || y
  | .xor => fun x y => x ^^ y

/-! ## Types

Type descriptors, over a crate-level enumeration `N` of type names. The descriptors are
plain data (no Lean type inside), so that a consumer of the deep terms can inspect and
compare them; the types which the language does not describe (trait-associated types,
raw pointers, …) are turned into type variables by the printer. -/

/-- The builtin types the library describes (and a consumer of the deep terms knows
about): the types of the standard library whose Lean model is an inductive type
mirroring the Rust declaration (`Option`, `Range`, `Ordering`), or an opaque type (`Vec`).
The other standard-library types used by a crate are in its own enumeration of type
names, without variants. -/
inductive BuiltinTy where
  | option
  | vec
  | range
  | ordering
  deriving DecidableEq, Repr

/-- A type name: a builtin type, or a type of the crate -/
inductive TypeRef (N : Type) where
  | builtin (b : BuiltinTy)
  | crate (T : N)

/-- A const-generic argument (`Usize`) -/
inductive CArg where
  /-- The `i`-th const-generic binder of the enclosing definition -/
  | var (i : Nat)
  | lit (n : Nat) (h : n ≤ UScalar.cMax .Usize)

/-- Type descriptors -/
inductive Ty (N : Type) : Type where
  /-- The `i`-th type binder of the enclosing definition -/
  | var (i : Nat)
  | scalar (ty : ScalarTy)
  | bool
  | char
  | unit
  /-- `Str` -/
  | str
  /-- Right-nested pairs, as the shallow printer prints tuples (two components at least) -/
  | tuple (tys : List (Ty N))
  /-- An ADT (builtin or of the crate), with its type and const-generic arguments -/
  | adt (T : TypeRef N) (targs : List (Ty N)) (cargs : List CArg)
  | array (τ : Ty N) (n : CArg)
  | slice (τ : Ty N)
  | result (τ : Ty N)
  | controlFlow (a b : Ty N)
  | arrow (a b : Ty N)

/-- The interpretation of the type and const-generic binders of a definition (or of the
parameters of a type declaration) -/
structure TyEnv where
  types : List Type := []
  consts : List Usize := []

/-- The `i`-th type of a list, `Unit` past the end. Reducible, unlike `List.getD`, so that
instance resolution (`DecidableEq`, `LT`, …) sees through the denotation of a type
variable. -/
@[reducible] def tyAt : List Type → Nat → Type
  | [], _ => Unit
  | t :: _, 0 => t
  | _ :: ts, n + 1 => tyAt ts n

/-- The closed world of ADTs of a crate: one generated instance per crate. -/
class TypeNames (N : Type) where
  /-- The Lean type, given the interpretation of the parameters of the declaration -/
  denote : N → TyEnv → Type
  /-- The field types of every variant (a single variant for structures), over the
  parameters of the declaration (`Ty.var i` is the `i`-th type parameter). Empty for
  the types which are not inductive definitions (opaque and builtin types). -/
  variants : N → List (List (Ty N))

def CArg.denote (κ : List Usize) : CArg → Usize
  | .var i => κ.getD i (Usize.ofNat 0)
  | .lit n h => Usize.ofNat n h

@[reducible] def BuiltinTy.denote : BuiltinTy → TyEnv → Type
  | .option, ρ => Option (tyAt ρ.types 0)
  | .vec, ρ => alloc.vec.Vec (tyAt ρ.types 0)
  | .range, ρ => core.ops.range.Range (tyAt ρ.types 0)
  | .ordering, _ => Ordering

/-- The field types of the variants of the builtin types, over their parameters -/
@[reducible] def BuiltinTy.variants {N : Type} : BuiltinTy → List (List (Ty N))
  | .option => [[], [.var 0]]
  | .vec => []
  | .range => [[.var 0, .var 0]]
  | .ordering => [[], [], []]

@[reducible] def TypeRef.denote {N : Type} [TypeNames N] : TypeRef N → TyEnv → Type
  | .builtin b, ρ => b.denote ρ
  | .crate T, ρ => TypeNames.denote T ρ

@[reducible] def TypeRef.variants {N : Type} [TypeNames N] : TypeRef N → List (List (Ty N))
  | .builtin b => b.variants
  | .crate T => TypeNames.variants T

mutual
  @[reducible] def Ty.denote {N : Type} [TypeNames N] (σ : TyEnv) : Ty N → Type
    | .var i => tyAt σ.types i
    | .scalar ty => ty.denote
    | .bool => Bool
    | .char => Char
    | .unit => Unit
    | .str => Str
    | .tuple tys => Tys.denoteTuple σ tys
    | .adt T targs cargs =>
      TypeRef.denote T ⟨Tys.denote σ targs, cargs.map (CArg.denote σ.consts)⟩
    | .array τ n => Array (τ.denote σ) (n.denote σ.consts)
    | .slice τ => Slice (τ.denote σ)
    | .result τ => Result (τ.denote σ)
    | .controlFlow a b => ControlFlow (a.denote σ) (b.denote σ)
    | .arrow a b => a.denote σ → b.denote σ
  /-- Right-nested tuples, as the shallow printer prints them -/
  @[reducible] def Tys.denoteTuple {N : Type} [TypeNames N] (σ : TyEnv) : List (Ty N) → Type
    | [] => Unit
    | [τ] => τ.denote σ
    | τ :: tys => τ.denote σ × Tys.denoteTuple σ tys
  @[reducible] def Tys.denote {N : Type} [TypeNames N] (σ : TyEnv) : List (Ty N) → List Type
    | [] => []
    | τ :: tys => τ.denote σ :: Tys.denote σ tys
end

/-- The interpretation of the parameters of a declaration (a type, a function, a global),
given its arguments -/
@[reducible] def Ty.argEnv {N : Type} [TypeNames N] (σ : TyEnv) (targs : List (Ty N))
    (cargs : List CArg) : TyEnv :=
  ⟨Tys.denote σ targs, cargs.map (CArg.denote σ.consts)⟩

/-- The Lean types of the fields of variant `v` of `T`, at the interpretation `ρ` of the
parameters of `T` -/
@[reducible] def TypeNames.fieldTys {N : Type} [TypeNames N] (T : TypeRef N) (v : Nat)
    (ρ : TyEnv) : List Type :=
  Tys.denote ρ ((TypeRef.variants T).getD v [])

/-- The constructor of variant `v` of `T`: one generated instance per variant of the
types of the crate, library instances for the builtin types -/
class CtorFn (N : Type) [TypeNames N] (T : TypeRef N) (v : Nat) where
  ctor : (ρ : TyEnv) → Fn (TypeNames.fieldTys T v ρ) (TypeRef.denote T ρ)

/-- The projector of field `f` of the structure `T`: one instance per field -/
class ProjFn (N : Type) [TypeNames N] (T : TypeRef N) (f : Nat) where
  proj : (ρ : TyEnv) → TypeRef.denote T ρ → (TypeNames.fieldTys T 0 ρ).getD f Unit

/-- The eliminator of `T` (`T.casesOn` with a constant motive): one instance per type -/
class ElimFn (N : Type) [TypeNames N] (T : TypeRef N) where
  elim : (ρ : TyEnv) →
    Elim (TypeRef.denote T ρ) ((TypeRef.variants T).map (Tys.denote ρ))

/-! ### The builtin types -/

section
variable {N : Type} [TypeNames N]

instance : CtorFn N (.builtin .option) 0 := ⟨fun _ => none⟩
instance : CtorFn N (.builtin .option) 1 := ⟨fun _ => fun x => some x⟩
instance : ElimFn N (.builtin .option) :=
  ⟨fun _ => fun x alts => Option.casesOn x alts.1 alts.2.1⟩

instance : CtorFn N (.builtin .range) 0 := ⟨fun _ => fun a b => core.ops.range.Range.mk a b⟩
instance : ProjFn N (.builtin .range) 0 := ⟨fun _ => fun r => r.start⟩
instance : ProjFn N (.builtin .range) 1 := ⟨fun _ => fun r => r.«end»⟩
instance : ElimFn N (.builtin .range) :=
  ⟨fun _ => fun x alts => core.ops.range.Range.casesOn x alts.1⟩

/-- `core::cmp::Ordering` is translated to Lean's `Ordering` (`lt`, `eq`, `gt`, in this order) -/
instance : CtorFn N (.builtin .ordering) 0 := ⟨fun _ => Ordering.lt⟩
instance : CtorFn N (.builtin .ordering) 1 := ⟨fun _ => Ordering.eq⟩
instance : CtorFn N (.builtin .ordering) 2 := ⟨fun _ => Ordering.gt⟩
instance : ElimFn N (.builtin .ordering) :=
  ⟨fun _ => fun x alts => Ordering.casesOn x alts.1 alts.2.1 alts.2.2.1⟩

end

/-- The signature of a function, over its type and const-generic parameters -/
structure Sig (N : Type) where
  inputs : List (Ty N)
  output : Ty N

/-- The description of a function: its signature and its (shallow) implementation at any
interpretation of its parameters. The two are bundled so that the generated tables are
plain matches whose arms do not depend on each other (a table with thousands of arms
whose types unfold another such table does not elaborate in reasonable time). -/
structure FunDef (N : Type) [TypeNames N] where
  sig : Sig N
  impl : (ρ : TyEnv) → Fn (Tys.denote ρ sig.inputs) (Ty.denote ρ sig.output)

/-- The closed world of functions of a crate: one generated instance per crate. Only the
functions without trait clauses are in the closed world. -/
class FunNames (F : Type) (N : Type) [TypeNames N] where
  defs : F → FunDef N

@[reducible] def FunNames.sig {F N : Type} [TypeNames N] [FunNames F N] (f : F) : Sig N :=
  (FunNames.defs (N := N) f).sig

@[reducible] def FunNames.impl {F N : Type} [TypeNames N] [FunNames F N] (f : F) (ρ : TyEnv) :
    Fn (Tys.denote ρ (FunNames.sig (N := N) f).inputs)
      (Ty.denote ρ (FunNames.sig (N := N) f).output) :=
  (FunNames.defs (N := N) f).impl ρ

/-- The description of a global: its type and its value -/
structure GlobalDef (N : Type) [TypeNames N] where
  ty : Ty N
  impl : (ρ : TyEnv) → Ty.denote ρ ty

/-- The closed world of globals of a crate -/
class GlobalNames (G : Type) (N : Type) [TypeNames N] where
  defs : G → GlobalDef N

@[reducible] def GlobalNames.ty {G N : Type} [TypeNames N] [GlobalNames G N] (g : G) : Ty N :=
  (GlobalNames.defs (N := N) g).ty

@[reducible] def GlobalNames.impl {G N : Type} [TypeNames N] [GlobalNames G N] (g : G)
    (ρ : TyEnv) : Ty.denote ρ (GlobalNames.ty (N := N) g) :=
  (GlobalNames.defs (N := N) g).impl ρ

/-! ### The primitives

The operations of the standard-library models with a dedicated name, so that a consumer
of the deep terms knows their semantics. `lift` and the array/slice accessors are the
builtins of the translation itself; the others are standard-library functions. -/

inductive Prim where
  /-- `lift` (`toResult`) -/
  | lift
  | arrayIndex
  | arrayUpdate
  | arrayIndexMut
  | arrayRepeat
  | arrayToSlice
  | sliceIndex
  | sliceUpdate
  | sliceIndexMut
  | sliceLen
  | vecLen
  | vecPush
  | vecNew
  deriving DecidableEq, Repr

/-- The signature and the implementation of each primitive: `.var 0` is the element type,
`CArg.var 0` the length of an array -/
@[reducible] def Prim.def {N : Type} [TypeNames N] : Prim → FunDef N
  | .lift => ⟨⟨[.var 0], .result (.var 0)⟩, fun ρ => @Std.lift (tyAt ρ.types 0)⟩
  | .arrayIndex =>
    ⟨⟨[.array (.var 0) (.var 0), .scalar (.u .Usize)], .result (.var 0)⟩,
     fun ρ => @Array.index_usize (tyAt ρ.types 0) (ρ.consts.getD 0 (Usize.ofNat 0))⟩
  | .arrayUpdate =>
    ⟨⟨[.array (.var 0) (.var 0), .scalar (.u .Usize), .var 0], .result (.array (.var 0) (.var 0))⟩,
     fun ρ => @Array.update (tyAt ρ.types 0) (ρ.consts.getD 0 (Usize.ofNat 0))⟩
  | .arrayIndexMut =>
    ⟨⟨[.array (.var 0) (.var 0), .scalar (.u .Usize)],
      .result (.tuple [.var 0, .arrow (.var 0) (.array (.var 0) (.var 0))])⟩,
     fun ρ => @Array.index_mut_usize (tyAt ρ.types 0) (ρ.consts.getD 0 (Usize.ofNat 0))⟩
  | .arrayRepeat =>
    ⟨⟨[.var 0], .array (.var 0) (.var 0)⟩,
     fun ρ => @Array.repeat (tyAt ρ.types 0) (ρ.consts.getD 0 (Usize.ofNat 0))⟩
  | .arrayToSlice =>
    ⟨⟨[.array (.var 0) (.var 0)], .slice (.var 0)⟩,
     fun ρ => @Array.to_slice (tyAt ρ.types 0) (ρ.consts.getD 0 (Usize.ofNat 0))⟩
  | .sliceIndex =>
    ⟨⟨[.slice (.var 0), .scalar (.u .Usize)], .result (.var 0)⟩,
     fun ρ => @Slice.index_usize (tyAt ρ.types 0)⟩
  | .sliceUpdate =>
    ⟨⟨[.slice (.var 0), .scalar (.u .Usize), .var 0], .result (.slice (.var 0))⟩,
     fun ρ => @Slice.update (tyAt ρ.types 0)⟩
  | .sliceIndexMut =>
    ⟨⟨[.slice (.var 0), .scalar (.u .Usize)],
      .result (.tuple [.var 0, .arrow (.var 0) (.slice (.var 0))])⟩,
     fun ρ => @Slice.index_mut_usize (tyAt ρ.types 0)⟩
  | .sliceLen => ⟨⟨[.slice (.var 0)], .scalar (.u .Usize)⟩, fun ρ => @Slice.len (tyAt ρ.types 0)⟩
  | .vecLen =>
    ⟨⟨[.adt (.builtin .vec) [.var 0] []], .scalar (.u .Usize)⟩,
     fun ρ => @alloc.vec.Vec.len (tyAt ρ.types 0)⟩
  | .vecPush =>
    ⟨⟨[.adt (.builtin .vec) [.var 0] [], .var 0], .result (.adt (.builtin .vec) [.var 0] [])⟩,
     fun ρ => @alloc.vec.Vec.push (tyAt ρ.types 0)⟩
  | .vecNew =>
    ⟨⟨[], .adt (.builtin .vec) [.var 0] []⟩, fun ρ => alloc.vec.Vec.new (tyAt ρ.types 0)⟩

/-- A function name: a primitive, or a function of the crate -/
inductive FunRef (F : Type) where
  | prim (p : Prim)
  | crate (f : F)

@[reducible] def FunRef.def {F N : Type} [TypeNames N] [FunNames F N] : FunRef F → FunDef N
  | .prim p => p.def
  | .crate f => FunNames.defs f

@[reducible] def FunRef.sig {F N : Type} [TypeNames N] [FunNames F N] (f : FunRef F) : Sig N :=
  (FunRef.def (N := N) f).sig

@[reducible] def FunRef.impl {F N : Type} [TypeNames N] [FunNames F N] (f : FunRef F)
    (ρ : TyEnv) :
    Fn (Tys.denote ρ (FunRef.sig (N := N) f).inputs) (Ty.denote ρ (FunRef.sig (N := N) f).output) :=
  (FunRef.def (N := N) f).impl ρ

/-! ## Environments, variables and patterns -/

/-- Environments: heterogeneous lists indexed by a typing context of descriptors. -/
inductive Env (N : Type) [TypeNames N] (σ : TyEnv) : List (Ty N) → Type where
  | nil : Env N σ []
  | cons {τ : Ty N} {Γ : List (Ty N)} (x : τ.denote σ) (xs : Env N σ Γ) : Env N σ (τ :: Γ)

infixr:67 " ::ₑ " => Env.cons

def Env.append {N : Type} [TypeNames N] {σ : TyEnv} :
    {Δ₁ Δ₂ : List (Ty N)} → Env N σ Δ₁ → Env N σ Δ₂ → Env N σ (Δ₁ ++ Δ₂)
  | _, _, .nil, ys => ys
  | _, _, .cons x xs, ys => .cons x (xs.append ys)

def Env.toHList {N : Type} [TypeNames N] {σ : TyEnv} :
    {Γ : List (Ty N)} → Env N σ Γ → HList (Tys.denote σ Γ)
  | _, .nil => .nil
  | _, .cons x xs => .cons x xs.toHList

def Env.ofHList {N : Type} [TypeNames N] {σ : TyEnv} :
    (Γ : List (Ty N)) → HList (Tys.denote σ Γ) → Env N σ Γ
  | [], .nil => .nil
  | _ :: Γ, .cons x xs => .cons x (Env.ofHList Γ xs)

/-- The value of a tuple, from the values of its components -/
def Env.toTuple {N : Type} [TypeNames N] {σ : TyEnv} :
    {tys : List (Ty N)} → Env N σ tys → Tys.denoteTuple σ tys
  | [], .nil => ()
  | [_], .cons x .nil => x
  | _ :: _ :: _, .cons x xs => (x, xs.toTuple)

/-- Typed de Bruijn indices. -/
inductive Var (N : Type) : List (Ty N) → Ty N → Type where
  | zero {Γ : List (Ty N)} {τ : Ty N} : Var N (τ :: Γ) τ
  | succ {Γ : List (Ty N)} {σ τ : Ty N} (v : Var N Γ τ) : Var N (σ :: Γ) τ

def Var.get {N : Type} [TypeNames N] {σ : TyEnv} :
    {Γ : List (Ty N)} → {τ : Ty N} → Var N Γ τ → Env N σ Γ → τ.denote σ
  | _, _, .zero, .cons x _ => x
  | _, _, .succ v, .cons _ xs => v.get xs

mutual
  /-- Irrefutable patterns. `Δ` lists the types of the bound variables, in binding order
  (the order in which the shallow printer and the pure AST number them). -/
  inductive Pat (N : Type) : Ty N → List (Ty N) → Type where
    | var {τ : Ty N} : Pat N τ [τ]
    | ignore {τ : Ty N} : Pat N τ []
    /-- A tuple pattern: one pattern per component -/
    | tuple {tys : List (Ty N)} {Δ : List (Ty N)} (ps : Pats N tys Δ) : Pat N (.tuple tys) Δ
  /-- The patterns of the components of a tuple; the bound variables are concatenated -/
  inductive Pats (N : Type) : List (Ty N) → List (Ty N) → Type where
    | nil : Pats N [] []
    | cons {τ : Ty N} {tys : List (Ty N)} {Δ₁ Δ₂ : List (Ty N)}
        (p : Pat N τ Δ₁) (ps : Pats N tys Δ₂) : Pats N (τ :: tys) (Δ₁ ++ Δ₂)
end

mutual
  /-- The environment extension produced by matching a value against a pattern. -/
  def Pat.bindEnv {N : Type} [TypeNames N] {σ : TyEnv} :
      {α : Ty N} → {Δ : List (Ty N)} → Pat N α Δ → α.denote σ → Env N σ Δ
    | _, _, .var, x => x ::ₑ .nil
    | _, _, .ignore, _ => .nil
    | _, _, .tuple ps, x => ps.bindEnv x
  def Pats.bindEnv {N : Type} [TypeNames N] {σ : TyEnv} :
      {tys : List (Ty N)} → {Δ : List (Ty N)} → Pats N tys Δ → Tys.denoteTuple σ tys → Env N σ Δ
    | _, _, .nil, _ => .nil
    | _, _, .cons p .nil, x => (p.bindEnv x).append .nil
    | _, _, .cons p (.cons q ps), x => (p.bindEnv x.1).append ((Pats.cons q ps).bindEnv x.2)
end

/-! ## Expressions -/

/-- Tags describing what a shallow leaf stands for. Metadata only: the denotation ignores it.

The names come from the Rust side of the translation:
- `fn`: the Rust name of the function (`crate::f`), with a `^loopN` (resp. `^loopN^body`)
  suffix for the function generated for the `N`-th loop (resp. its body), or `@name` for the
  builtins of the translation (`@assert`, `@toResult`, `@arrayIndex`, …);
- `ctor`: the Rust name of a variant of a type outside the closed world;
- `proj`: the name of a field of a type outside the closed world;
- `binop`, `unop`: an operator without a dedicated node (the operator with its overflow
  mode and its type, e.g. `wrap.+::<u32>`);
- `global`: the Rust name of the global. -/
inductive Leaf where
  | lit
  | fn (name : String)
  | global (name : String)
  | ctor (name : String)
  | proj (name : String)
  | binop (name : String)
  | unop (name : String)
  | other (name : String)
  deriving Repr, DecidableEq, Inhabited

mutual
  inductive Expr (N F G : Type) [TypeNames N] [FunNames F N] [GlobalNames G N] (σ : TyEnv) :
      List (Ty N) → Ty N → Type 1 where
    | var {Γ : List (Ty N)} {τ : Ty N} (v : Var N Γ τ) : Expr N F G σ Γ τ
    /-- A shallow leaf: literal, function, global, … -/
    | leaf {Γ : List (Ty N)} (tag : Leaf) (τ : Ty N) (c : τ.denote σ) : Expr N F G σ Γ τ
    | app {Γ : List (Ty N)} {α β : Ty N} (f : Expr N F G σ Γ (.arrow α β)) (a : Expr N F G σ Γ α) :
        Expr N F G σ Γ β
    | lam {Γ : List (Ty N)} {β : Ty N} {Δ : List (Ty N)} (α : Ty N)
        (p : Pat N α Δ) (body : Expr N F G σ (Δ ++ Γ) β) : Expr N F G σ Γ (.arrow α β)
    /-- Non-monadic let-binding -/
    | let_ {Γ : List (Ty N)} {α β : Ty N} {Δ : List (Ty N)}
        (e : Expr N F G σ Γ α) (p : Pat N α Δ) (k : Expr N F G σ (Δ ++ Γ) β) : Expr N F G σ Γ β
    /-- Monadic let-binding -/
    | bind {Γ : List (Ty N)} {α β : Ty N} {Δ : List (Ty N)}
        (e : Expr N F G σ Γ (.result α)) (p : Pat N α Δ) (k : Expr N F G σ (Δ ++ Γ) (.result β)) :
        Expr N F G σ Γ (.result β)
    | ite {Γ : List (Ty N)} {τ : Ty N} (c : Cond N F G σ Γ) (t e : Expr N F G σ Γ τ) : Expr N F G σ Γ τ
    /-- A checked binary operation on scalars (see `ScalarBinop`) -/
    | scalarBinop {Γ : List (Ty N)} (op : ScalarBinop) (ty : ScalarTy)
        (a : Expr N F G σ Γ (.scalar ty)) (b : Expr N F G σ Γ (.scalar (op.rhsTy ty))) :
        Expr N F G σ Γ (.result (.scalar ty))
    /-- A bitwise binary operation on scalars (see `ScalarBitop`) -/
    | scalarBitop {Γ : List (Ty N)} (op : ScalarBitop) (ty : ScalarTy)
        (a b : Expr N F G σ Γ (.scalar ty)) : Expr N F G σ Γ (.scalar ty)
    /-- `-. x`, the checked negation of a signed scalar -/
    | neg {Γ : List (Ty N)} (ty : IScalarTy) (a : Expr N F G σ Γ (.scalar (.i ty))) :
        Expr N F G σ Γ (.result (.scalar (.i ty)))
    /-- `~~~ x` -/
    | bitNot {Γ : List (Ty N)} (ty : ScalarTy) (a : Expr N F G σ Γ (.scalar ty)) :
        Expr N F G σ Γ (.scalar ty)
    /-- A cast between scalar types -/
    | cast {Γ : List (Ty N)} (src tgt : ScalarTy) (a : Expr N F G σ Γ (.scalar src)) :
        Expr N F G σ Γ (.scalar tgt)
    /-- A cast from a boolean to a scalar -/
    | castFromBool {Γ : List (Ty N)} (tgt : ScalarTy) (a : Expr N F G σ Γ .bool) :
        Expr N F G σ Γ (.scalar tgt)
    | boolBinop {Γ : List (Ty N)} (op : BoolBinop) (a b : Expr N F G σ Γ .bool) : Expr N F G σ Γ .bool
    /-- `¬ b` used as a boolean (the shallow code elaborates it to `decide (¬ b = true)`) -/
    | boolNot {Γ : List (Ty N)} (a : Expr N F G σ Γ .bool) : Expr N F G σ Γ .bool
    /-- `a != b` (`bne`) -/
    | bne {Γ : List (Ty N)} {α : Ty N} [inst : BEq (α.denote σ)] (a b : Expr N F G σ Γ α) :
        Expr N F G σ Γ .bool
    /-- An unsigned scalar literal (`n#u32`) -/
    | uscalarLit {Γ : List (Ty N)} (ty : UScalarTy) (n : Nat) (h : n ≤ UScalar.cMax ty) :
        Expr N F G σ Γ (.scalar (.u ty))
    /-- A signed scalar literal (`n#i32`) -/
    | iscalarLit {Γ : List (Ty N)} (ty : IScalarTy) (n : Int)
        (h : IScalar.cMin ty ≤ n ∧ n ≤ IScalar.cMax ty) : Expr N F G σ Γ (.scalar (.i ty))
    | boolLit {Γ : List (Ty N)} (b : Bool) : Expr N F G σ Γ .bool
    | unitLit {Γ : List (Ty N)} : Expr N F G σ Γ .unit
    /-- A condition used as a boolean: the shallow code coerces it with `decide` -/
    | decide {Γ : List (Ty N)} (c : Cond N F G σ Γ) : Expr N F G σ Γ .bool
    /-- `massert c` -/
    | assert {Γ : List (Ty N)} (c : Cond N F G σ Γ) : Expr N F G σ Γ (.result .unit)
    /-- `ok e` -/
    | ok {Γ : List (Ty N)} {τ : Ty N} (e : Expr N F G σ Γ τ) : Expr N F G σ Γ (.result τ)
    /-- `fail err` -/
    | fail {Γ : List (Ty N)} (τ : Ty N) (err : Error) : Expr N F G σ Γ (.result τ)
    /-- A tuple (two components at least) -/
    | tuple {Γ : List (Ty N)} {tys : List (Ty N)} (es : Exprs N F G σ Γ tys) :
        Expr N F G σ Γ (.tuple tys)
    /-- The constructor of variant `v` of `T`, applied to the field values. `fields` are
    the types of the fields at the type arguments: `h` states that they agree with the
    declaration (`rfl` in generated terms). -/
    | ctor {Γ : List (Ty N)} (T : TypeRef N) (v : Nat) [inst : CtorFn N T v]
        (targs : List (Ty N)) (cargs : List CArg) (fields : List (Ty N))
        (h : Tys.denote σ fields = TypeNames.fieldTys T v (Ty.argEnv σ targs cargs))
        (args : Exprs N F G σ Γ fields) : Expr N F G σ Γ (.adt T targs cargs)
    /-- The projection of field `f` of the structure `T`. `τ` is the type of the field
    at the type arguments: `h` states that it agrees with the declaration. -/
    | proj {Γ : List (Ty N)} (T : TypeRef N) (f : Nat) [inst : ProjFn N T f]
        (targs : List (Ty N)) (cargs : List CArg) (τ : Ty N)
        (h : (TypeNames.fieldTys T 0 (Ty.argEnv σ targs cargs)).getD f Unit = τ.denote σ)
        (e : Expr N F G σ Γ (.adt T targs cargs)) : Expr N F G σ Γ τ
    /-- A match on a value of type `T`, with one branch per variant binding its fields.
    `shape` lists the field types of the variants at the type arguments: `h` states that
    they agree with the declaration. -/
    | match_ {Γ : List (Ty N)} {τ : Ty N} (T : TypeRef N) [inst : ElimFn N T]
        (targs : List (Ty N)) (cargs : List CArg) (shape : List (List (Ty N)))
        (h : shape.map (Tys.denote σ) =
          (TypeRef.variants T).map (Tys.denote (Ty.argEnv σ targs cargs)))
        (scrut : Expr N F G σ Γ (.adt T targs cargs)) (brs : Branches N F G σ Γ shape τ) :
        Expr N F G σ Γ τ
    /-- A call to a primitive or to a function of the crate, applied to all its arguments. `inputs` and
    `output` are the types at the type arguments: `h₁`, `h₂` state that they agree with
    the signature (`rfl` in generated terms). -/
    | call {Γ : List (Ty N)} (f : FunRef F) (targs : List (Ty N)) (cargs : List CArg)
        (inputs : List (Ty N)) (output : Ty N)
        (h₁ : Tys.denote σ inputs = Tys.denote (Ty.argEnv σ targs cargs) (FunRef.sig (N := N) f).inputs)
        (h₂ : Ty.denote (Ty.argEnv σ targs cargs) (FunRef.sig (N := N) f).output = output.denote σ)
        (args : Exprs N F G σ Γ inputs) : Expr N F G σ Γ output
    /-- A global of the crate -/
    | global {Γ : List (Ty N)} (g : G) (targs : List (Ty N)) (cargs : List CArg) (τ : Ty N)
        (h : Ty.denote (Ty.argEnv σ targs cargs) (GlobalNames.ty (N := N) g) = τ.denote σ) :
        Expr N F G σ Γ τ
    /-- `ControlFlow.cont e` -/
    | continue_ {Γ : List (Ty N)} (α β : Ty N) (e : Expr N F G σ Γ α) :
        Expr N F G σ Γ (.controlFlow α β)
    /-- `ControlFlow.done e` -/
    | break_ {Γ : List (Ty N)} (α β : Ty N) (e : Expr N F G σ Γ β) :
        Expr N F G σ Γ (.controlFlow α β)
    /-- The loop fixed-point combinator -/
    | loop {Γ : List (Ty N)} {α β : Ty N}
        (body : Expr N F G σ Γ (.arrow α (.result (.controlFlow α β)))) (init : Expr N F G σ Γ α) :
        Expr N F G σ Γ (.result β)
    /-- Escape hatch: an arbitrary shallow function of the environment -/
    | shallow {Γ : List (Ty N)} (τ : Ty N) (f : Env N σ Γ → τ.denote σ) : Expr N F G σ Γ τ

  /-- Lists of expressions (arguments of constructors, components of tuples) -/
  inductive Exprs (N F G : Type) [TypeNames N] [FunNames F N] [GlobalNames G N] (σ : TyEnv) :
      List (Ty N) → List (Ty N) → Type 1 where
    | nil {Γ : List (Ty N)} : Exprs N F G σ Γ []
    | cons {Γ : List (Ty N)} {τ : Ty N} {tys : List (Ty N)}
        (e : Expr N F G σ Γ τ) (es : Exprs N F G σ Γ tys) : Exprs N F G σ Γ (τ :: tys)

  /-- `if` conditions. Each constructor mirrors the proposition and the `Decidable` instance
  that the elaborator produces for the corresponding shallow syntax. -/
  inductive Cond (N F G : Type) [TypeNames N] [FunNames F N] [GlobalNames G N] (σ : TyEnv) :
      List (Ty N) → Type 1 where
    /-- `if b` where `b : Bool`, elaborated to `ite (b = true)` -/
    | bool {Γ : List (Ty N)} (b : Expr N F G σ Γ .bool) : Cond N F G σ Γ
    /-- `if ¬ c` -/
    | not {Γ : List (Ty N)} (c : Cond N F G σ Γ) : Cond N F G σ Γ
    | eq {Γ : List (Ty N)} {α : Ty N} [inst : DecidableEq (α.denote σ)]
        (a b : Expr N F G σ Γ α) : Cond N F G σ Γ
    | lt {Γ : List (Ty N)} {α : Ty N} [ord : LT (α.denote σ)]
        [inst : DecidableRel (· < · : α.denote σ → α.denote σ → Prop)]
        (a b : Expr N F G σ Γ α) : Cond N F G σ Γ
    | le {Γ : List (Ty N)} {α : Ty N} [ord : LE (α.denote σ)]
        [inst : DecidableRel (· ≤ · : α.denote σ → α.denote σ → Prop)]
        (a b : Expr N F G σ Γ α) : Cond N F G σ Γ
    | gt {Γ : List (Ty N)} {α : Ty N} [ord : LT (α.denote σ)]
        [inst : DecidableRel (· < · : α.denote σ → α.denote σ → Prop)]
        (a b : Expr N F G σ Γ α) : Cond N F G σ Γ
    | ge {Γ : List (Ty N)} {α : Ty N} [ord : LE (α.denote σ)]
        [inst : DecidableRel (· ≤ · : α.denote σ → α.denote σ → Prop)]
        (a b : Expr N F G σ Γ α) : Cond N F G σ Γ

  /-- Match branches, one per variant, each binding the variant's fields. -/
  inductive Branches (N F G : Type) [TypeNames N] [FunNames F N] [GlobalNames G N]
      (σ : TyEnv) : List (Ty N) → List (List (Ty N)) → Ty N → Type 1 where
    | nil {Γ : List (Ty N)} {τ : Ty N} : Branches N F G σ Γ [] τ
    | cons {Γ : List (Ty N)} {Δ : List (Ty N)} {shape : List (List (Ty N))} {τ : Ty N}
        (b : Expr N F G σ (Δ ++ Γ) τ) (bs : Branches N F G σ Γ shape τ) :
        Branches N F G σ Γ (Δ :: shape) τ
end

/-! ## Denotation -/

mutual
  def Expr.denote {N F G : Type} [TypeNames N] [FunNames F N] [GlobalNames G N] {σ : TyEnv} :
      {Γ : List (Ty N)} → {τ : Ty N} → Expr N F G σ Γ τ → Env N σ Γ → τ.denote σ
    | _, _, .var v, env => v.get env
    | _, _, .leaf _ _ c, _ => c
    | _, _, .app f a, env => (f.denote env) (a.denote env)
    | _, _, .lam _ p b, env => fun x => b.denote ((p.bindEnv x).append env)
    | _, _, .let_ e p k, env =>
      let x := e.denote env
      k.denote ((p.bindEnv x).append env)
    | _, _, .bind e p k, env =>
      Std.bind (e.denote env) (fun x => k.denote ((p.bindEnv x).append env))
    | _, _, .ite c t e, env =>
      @ite _ (c.denote env).prop (c.denote env).dec (t.denote env) (e.denote env)
    | _, _, .scalarBinop op ty a b, env => op.denote ty (a.denote env) (b.denote env)
    | _, _, .scalarBitop op ty a b, env => op.denote ty (a.denote env) (b.denote env)
    | _, _, .neg _ a, env => -. (a.denote env)
    | _, _, .bitNot ty a, env => ty.bitNot (a.denote env)
    | _, _, .cast src tgt a, env => ScalarTy.cast src tgt (a.denote env)
    | _, _, .castFromBool tgt a, env => ScalarTy.castFromBool tgt (a.denote env)
    | _, _, .boolBinop op a b, env => op.denote (a.denote env) (b.denote env)
    | _, _, .boolNot a, env => (¬ (a.denote env) : Bool)
    | _, _, .bne (inst := inst) a b, env => @bne _ inst (a.denote env) (b.denote env)
    | _, _, .uscalarLit _ n h, _ => UScalar.ofNat n h
    | _, _, .iscalarLit _ n h, _ => IScalar.ofInt n h
    | _, _, .boolLit b, _ => b
    | _, _, .unitLit, _ => ()
    | _, _, .decide c, env => @Decidable.decide (c.denote env).prop (c.denote env).dec
    | _, _, .assert c, env => @Std.massert (c.denote env).prop (c.denote env).dec
    | _, _, .ok e, env => Result.ok (e.denote env)
    | _, _, .fail _ err, _ => Result.fail err
    | _, _, .tuple es, env => (es.denote env).toTuple
    | _, _, .ctor _ _ (inst := inst) targs cargs _ h args, env =>
      Fn.apply (inst.ctor (Ty.argEnv σ targs cargs)) (h ▸ (args.denote env).toHList)
    | _, _, .proj _ _ (inst := inst) targs cargs _ h e, env =>
      h ▸ inst.proj (Ty.argEnv σ targs cargs) (e.denote env)
    | _, _, .match_ _ (inst := inst) targs cargs _ h s brs, env =>
      inst.elim (Ty.argEnv σ targs cargs) (s.denote env) (h ▸ brs.denote env)
    | _, _, .call f targs cargs _ _ h₁ h₂ args, env =>
      h₂ ▸ Fn.apply (FunRef.impl (N := N) f (Ty.argEnv σ targs cargs)) (h₁ ▸ (args.denote env).toHList)
    | _, _, .global g targs cargs _ h, _ => h ▸ GlobalNames.impl (N := N) g (Ty.argEnv σ targs cargs)
    | _, _, .continue_ _ _ e, env => ControlFlow.cont (e.denote env)
    | _, _, .break_ _ _ e, env => ControlFlow.done (e.denote env)
    | _, _, .loop b i, env => Std.loop (b.denote env) (i.denote env)
    | _, _, .shallow _ f, env => f env

  def Exprs.denote {N F G : Type} [TypeNames N] [FunNames F N] [GlobalNames G N] {σ : TyEnv} :
      {Γ : List (Ty N)} → {tys : List (Ty N)} → Exprs N F G σ Γ tys → Env N σ Γ → Env N σ tys
    | _, _, .nil, _ => .nil
    | _, _, .cons e es, env => .cons (e.denote env) (es.denote env)

  def Cond.denote {N F G : Type} [TypeNames N] [FunNames F N] [GlobalNames G N] {σ : TyEnv} :
      {Γ : List (Ty N)} → Cond N F G σ Γ → Env N σ Γ → DecProp
    | _, .bool b, env => ⟨b.denote env = true, inferInstance⟩
    | _, .not c, env => ⟨¬ (c.denote env).prop, @instDecidableNot _ (c.denote env).dec⟩
    | _, .eq (inst := inst) a b, env => ⟨a.denote env = b.denote env, inst _ _⟩
    | _, .lt (ord := ord) (inst := inst) a b, env =>
      ⟨@LT.lt _ ord (a.denote env) (b.denote env), inst _ _⟩
    | _, .le (ord := ord) (inst := inst) a b, env =>
      ⟨@LE.le _ ord (a.denote env) (b.denote env), inst _ _⟩
    | _, .gt (ord := ord) (inst := inst) a b, env =>
      ⟨@GT.gt _ ord (a.denote env) (b.denote env), inst _ _⟩
    | _, .ge (ord := ord) (inst := inst) a b, env =>
      ⟨@GE.ge _ ord (a.denote env) (b.denote env), inst _ _⟩

  def Branches.denote {N F G : Type} [TypeNames N] [FunNames F N] [GlobalNames G N] {σ : TyEnv} :
      {Γ : List (Ty N)} → {shape : List (List (Ty N))} → {τ : Ty N} →
      Branches N F G σ Γ shape τ → Env N σ Γ → Alts (shape.map (Tys.denote σ)) (τ.denote σ)
    | _, _, _, .nil, _ => ()
    | _, _, _, .cons (Δ := Δ) b bs, env =>
      (HList.curry (Tys.denote σ Δ) (fun fields => b.denote ((Env.ofHList Δ fields).append env)),
       bs.denote env)
end

/-! ## Helpers for building terms -/

namespace Expr

variable {N F G : Type} [TypeNames N] [FunNames F N] [GlobalNames G N] {σ : TyEnv}
  {Γ : List (Ty N)}

abbrev lit (τ : Ty N) (c : τ.denote σ) : Expr N F G σ Γ τ := .leaf .lit τ c
/-- A function outside the closed world, as a leaf -/
abbrev fnLeaf (name : String) (τ : Ty N) (f : τ.denote σ) : Expr N F G σ Γ τ :=
  .leaf (.fn name) τ f

abbrev app2 {α β γ : Ty N} (f : Expr N F G σ Γ (.arrow α (.arrow β γ)))
    (a : Expr N F G σ Γ α) (b : Expr N F G σ Γ β) : Expr N F G σ Γ γ :=
  .app (.app f a) b

abbrev app3 {α β γ δ : Ty N} (f : Expr N F G σ Γ (.arrow α (.arrow β (.arrow γ δ))))
    (a : Expr N F G σ Γ α) (b : Expr N F G σ Γ β) (c : Expr N F G σ Γ γ) : Expr N F G σ Γ δ :=
  .app (.app (.app f a) b) c

abbrev pair {α β : Ty N} (a : Expr N F G σ Γ α) (b : Expr N F G σ Γ β) : Expr N F G σ Γ (.tuple [α, β]) :=
  .tuple (.cons a (.cons b .nil))

end Expr

end Aeneas.Deep

  massert (a < 3329#u32)
  massert (b < 3329#u32)
  let sum ← a + b
  let res ← lift (core.num.U32.wrapping_sub sum 3329#u32)
  let mask ← res >>> 16#i32
  let q ← lift (3329#u32 &&& mask)
  ok (core.num.U32.wrapping_add res q)


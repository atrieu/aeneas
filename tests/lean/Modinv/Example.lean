import Aeneas.Deep.CDriver
import Modinv.Modinv

/-! # From Rust to verified C: modular inversion

`tests/src/modinv.rs` computes the inverse of a residue modulo the prime `P` just below
`2^32` by Fermat's little theorem, `a⁻¹ = a^(P-2) mod P`, with a square-and-multiply
exponentiation. This file walks through the pipeline of `PLAN-compiler.md` on it:

1. **The translation** (`Modinv.lean`, generated by `aeneas -deep`): the Lean functions
   `mul_mod`, `pow_mod`, its loop `pow_mod_loop` and loop body, `inv_mod`, the constant
   `P`; their *deep terms* `f.deep`, first-order ASTs over the closed world of the crate;
   and the theorems `f.deep_eq`, proved by reflexivity, stating that the deep term denotes
   the function.
2. **The compilation** of the deep terms to the C-shaped IR (`Aeneas.Deep.Compile`), with
   the coverage report `#deep_report`.
3. **The correctness theorem** `compile_correct`, instantiated: the IR program computes the
   translated function.
4. **The C** (`GenC.lean`, `C/run.sh`): the trusted printer prints the IR, and the harness
   runs the C against the values Lean computes.
-/

open Aeneas Aeneas.Std Aeneas.Deep

namespace modinv

/-! ## 1. The deep terms denote the translated functions (generated theorems) -/

example (a : U64) : inv_mod a = inv_mod.deep.denote (a ::ₑ .nil) := inv_mod.deep_eq a
example (base exp : U64) : pow_mod base exp = pow_mod.deep.denote (base ::ₑ exp ::ₑ .nil) :=
  pow_mod.deep_eq base exp

/-! ## 2. Every function of the crate is in the fragment of the compiler

(`#deep_report` runs on the whole environment: the three unsupported terms it lists are
the hand-written tests of the library, `Aeneas.Deep.Tests`, which return closures.) -/

#deep_report

example : (Compile.compile mul_mod.deep).toBool = true := by decide
example : (Compile.compile pow_mod_loop.body.deep).toBool = true := by decide
example : (Compile.compile pow_mod_loop.deep).toBool = true := by decide
example : (Compile.compile pow_mod.deep).toBool = true := by decide
example : (Compile.compile inv_mod.deep).toBool = true := by decide

/-! ## 3. The IR program computes the translated function

`compile_correct` says that the interpreter of the IR, on the compiled body, computes the
denotation of the deep term; with `deep_eq`, this is the translated Rust function. The
statement is unconditional on the inputs: failures (an overflow, a division by zero) and
divergence are values of the `Result` monad on both sides. -/

theorem inv_mod_ir_correct {s} (h : Compile.compile inv_mod.deep = .ok s) (a : U64) :
    s.exec (a ::ₑ .nil) = inv_mod a := by
  rw [Compile.compile_correct inv_mod.deep s h, inv_mod.deep_eq]

theorem pow_mod_ir_correct {s} (h : Compile.compile pow_mod.deep = .ok s) (base exp : U64) :
    s.exec (base ::ₑ exp ::ₑ .nil) = pow_mod base exp := by
  rw [Compile.compile_correct pow_mod.deep s h, pow_mod.deep_eq]

/-! ## 4. Sample values, by evaluation

`3⁻¹ = 1431655764` modulo `P = 4294967291` (and `3 · 1431655764 ≡ 1`). The translated
function and the IR interpreter agree, as the theorem says; the C harness (`C/run.sh`)
checks the same values on the printed program. -/

example : Result.reducesTo (inv_mod 3#u64) 1431655764#u64 := by native_decide
example : Result.reducesTo (mul_mod 3#u64 1431655764#u64) 1#u64 := by native_decide
example : (match Compile.compile inv_mod.deep with
    | .ok s => Result.reducesTo (s.exec (3#u64 ::ₑ .nil)) 1431655764#u64
    | .error _ => false) = true := by native_decide

end modinv
